   {
    "id": "new-todos-go-to-the-bottom-of-the-list",
    "file": "suites/todomvc-strict/new-todos-go-to-the-bottom-of-the-list_test.md",
    "title": "New todos go to the bottom of the list",
    "summary": "Rewritten from \"Enter appends trimmed todo and clears new-todo input\", which passed on a build that puts new todos at the top: the old sentence named the new item but not where it goes.",
    "steps": [
     {
      "heading": "Step 1",
      "text": "Open {{start_url}} in the browser and load the todo app, then, in the new-todo input at the top, type 'Buy milk' and press Enter, then assert the todo list shows exactly one row and it reads 'Buy milk'.",
      "verifies": []
     },
     {
      "heading": "Step 2",
      "text": "In the same new-todo input, type 'Call home' and press Enter, then assert the todo list shows exactly two rows, the upper row reads 'Buy milk' and the lower row reads 'Call home'.",
      "verifies": []
     }
    ],
    "sha256": "dcf34c174ad107bf1ccfbbe9abfd82610cce34e56219c2df37527f866a6aa5ea"
   },
   {
    "id": "spaces-only-entry-adds-no-row-and-no-counter",
    "file": "suites/todomvc-strict/spaces-only-entry-adds-no-row-and-no-counter_test.md",
    "title": "A spaces-only entry adds no row and no counter",
    "summary": "Rewritten from \"Blank new-todo submissions do not add a todo\", which passed on a build that adds an empty row: the old sentence counted todos, and an empty row has no title to count.",
    "steps": [
     {
      "heading": "Step 1",
      "text": "Open {{start_url}} in the browser and load the todo app, then, in the new-todo input at the top, type three spaces and press Enter, then assert the page shows no todo rows at all, not even an empty one, and no \"item left\" or \"items left\" counter is shown.",
      "verifies": []
     }
    ],
    "sha256": "c89c6eef199450a95040fd859c5f0da72eea314f29634232217b51245340a752"
   }
  ],
  "variables": {
   "active_todo_title": "Pay rent",
   "completed_todo_title": "Book the dentist"
  }
 },
