{
  "name": "ditto",
  "version": "0.1.0",
  "description": "Let an AI agent rewrite your frontend. Kane CLI runs the same plain-English tests on the old app and the rewrite until they behave the same.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ditto": "./bin/ditto.mjs"
  },
  "scripts": {
    "ditto": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --import tsx --test test/*.test.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "site:build": "node scripts/build-site.mjs",
    "site:publish": "bash scripts/publish-pages.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
